# ── Worker ────────────────────────────────────────────────────────────
# Clave maestra para cifrar credenciales de conexiones (AES-256-GCM).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SONDADATA_SECRET_KEY=

# Carpeta de datos del worker (jobs, artefactos, uploads, exports).
# En producción: un volumen persistente.
SONDADATA_DATA_DIR=

# Puerto del worker.
PORT=8787

# ── Web ───────────────────────────────────────────────────────────────
# URL pública del worker, vista desde el navegador del usuario.
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
